!/public/assets/images/hero/*

# Operational Uploads - Ignored in Git
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/pages/
!/public/uploads/pages/*
!/public/uploads/testimonials/
!/public/uploads/testimonials/*
.DS_Store
